{
  "name": "dsh-session-favorites",
  "version": "0.2.2",
  "description": "常用对话卡片：在右侧卡片栏收藏、查找和快速打开对话。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": { "check": "node --check lib/index.js && node --check lib/service.js && node --check lib/attention.js && node --check lib/client.js", "test": "node --test tests/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-workspace", "dsh-capability-selector"]
    }
  }
}
