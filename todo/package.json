{
  "name": "dsh-todo",
  "version": "0.1.0",
  "description": "待办：仿 iPhone 提醒事项的待办页面与右侧卡片，支持智能列表、截止时间与旗标、关联会话、到点提醒和 Agent 读写。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/144magixx/dsh-plugin.git", "directory": "todo" },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/service.js && node --check lib/core.js && node --check lib/client.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-session"]
    }
  }
}
