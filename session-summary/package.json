{
  "name": "dsh-session-summary",
  "version": "0.3.1",
  "description": "Codex-style pinned session summary card for DSH: changes, subagents, sources, plan, generated files, background jobs and related sessions at the conversation's top-right.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "docs/使用文档.md", "docs/preview/card-light.png", "docs/preview/card-dark.png", "docs/preview/card-light-bottom.png"],
  "engines": {"node": ">=22"},
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "test:integration": "node --test tests/integration-*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
