{
  "name": "dsh-capability-selector",
  "version": "0.1.2",
  "description": "Discover and deduplicate local Skills, enterprise CLIs and MCP configurations; choose capabilities for the current DSH task.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "docs"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check lib/index.js && node --check lib/discovery.js && node --check lib/client.js",
    "test:browser": "node scripts/test-browser.mjs",
    "test:integration": "node --test tests/integration-backend.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
