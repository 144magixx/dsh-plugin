{
  "name": "dsh-task-guardian",
  "version": "0.2.0",
  "description": "Persistent cross-session task interruption alerts in the right-side card, with session navigation and read acknowledgements.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/alerts.js && node --check lib/client.js && node --check lib/store.js",
    "pretest": "node ../session-summary/scripts/extract-test-runtime.mjs @deepseek-ai/cordis @deepseek-ai/dsh-session @deepseek-ai/dsh-session-projection",
    "test": "node --test tests/*.test.js",
    "pretest:integration": "node ../session-summary/scripts/extract-test-runtime.mjs @deepseek-ai/cordis @deepseek-ai/dsh-typert-registry @deepseek-ai/dsh-session @deepseek-ai/dsh-session-projection @deepseek-ai/dsh-storage @deepseek-ai/dsh-storage-json @deepseek-ai/dsh-storage-domain @deepseek-ai/dsh-session-query @deepseek-ai/dsh-llm-retry",
    "test:integration": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-workspace"] } }
}
