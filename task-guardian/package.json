{
  "name": "dsh-task-guardian",
  "version": "0.1.2",
  "description": "Per-session request retry guardian with durable audit, conservative recovery review and question deadlines.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "docs"],
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/retry.js && node --check lib/recovery.js && node --check lib/questions.js && node --check lib/store.js && node --check lib/startup.js",
    "pretest": "node ../session-summary/scripts/extract-test-runtime.mjs @deepseek-ai/cordis @deepseek-ai/dsh-llm-retry @deepseek-ai/dsh-session @deepseek-ai/dsh-session-projection",
    "test": "node --test tests/*.test.js",
    "pretest:integration": "node ../session-summary/scripts/extract-test-runtime.mjs @deepseek-ai/cordis @deepseek-ai/dsh-typert-registry @deepseek-ai/dsh-session @deepseek-ai/dsh-session-projection @deepseek-ai/dsh-session-persistence-jsonl @deepseek-ai/dsh-storage @deepseek-ai/dsh-storage-json @deepseek-ai/dsh-storage-domain @deepseek-ai/dsh-system-prompt @deepseek-ai/dsh-tools @deepseek-ai/dsh-llm @deepseek-ai/dsh-agent @deepseek-ai/dsh-session-query @deepseek-ai/dsh-agent-loop @deepseek-ai/dsh-llm-retry",
    "test:integration": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-accessory-browser.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar-right"] } }
}
