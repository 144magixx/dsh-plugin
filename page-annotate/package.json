{
  "name": "dsh-page-annotate",
  "version": "0.2.1",
  "description": "页面批注：在 HTML 预览里点选或框选，留下问题、想法或修改要求，将批注和截图保存为紧凑文件引用加入对话。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE", "vendor/html-to-image.LICENSE"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/144magixx/dsh-plugin.git", "directory": "page-annotate" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
