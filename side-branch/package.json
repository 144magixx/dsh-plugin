{
  "name": "dsh-side-branch",
  "version": "0.1.0",
  "description": "Side Branch (岔路): continue from a historical turn or revise a past question in a native DSH sidebar conversation.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/service.js", "lib/history.js", "lib/client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "docs", "scripts/INTEGRATION.md"],
  "engines": {"node": ">=22"},
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/run-integration.mjs",
    "check": "node --check lib/index.js && node --check lib/service.js && node --check lib/history.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-resources", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
