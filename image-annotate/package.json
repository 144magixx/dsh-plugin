{
  "name": "dsh-image-annotate",
  "version": "0.1.0",
  "description": "图片标注：双击输入框里的待发送图片进入编辑，支持文字、圈画、箭头、序号、荧光笔、马赛克；保存后自动替换原图并保持顺序。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/144magixx/dsh-plugin.git", "directory": "image-annotate" },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/build-real.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-attachment"]
    }
  }
}
